# check=skip=InvalidBaseImagePlatform
# Ave node, SQLite WITHOUT compiler role (no toolchain, no vendor).
# Every RUN executes on the host architecture. TARGETARCH only selects
# the files being produced, so both build directions work without QEMU.
# Usage (from the workspace root /home/ale/dev):
#   docker build --platform linux/amd64 --target amd64 -f ave/http/docker/Dockerfile.node-sqlite .
#   docker build --platform linux/arm64 --target arm64 -f ave/http/docker/Dockerfile.node-sqlite .

ARG DEBIAN_AMD64_DIGEST=sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2
ARG DEBIAN_ARM64_DIGEST=sha256:a66b19aa552f595b4ab276c6b4f9b24fa4546632c5ecd88cccdced4a6866323a
ARG DEBIAN_SNAPSHOT=20261029T082808Z
ARG DEBIAN_SECURITY_SNAPSHOT=20261029T072456Z
ARG DISTROLESS_AMD64_DIGEST=sha256:a0426fc2d66bbaa64fa3577e6d654411a671752b8eba243882cc3cc533a00613
ARG DISTROLESS_ARM64_DIGEST=sha256:76fe70b16ed7943288c1aacecbdb73edfdb5f5e75577ad6ae4de069b966862c9
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_AMD64_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ARG RUSTUP_ARM64_SHA256=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c
ARG NODE_RUSTC_VERSION=1.98.1
ARG CARGO_PROFILE=release
ARG FEATURES="ext-sqlite sqlite prometheus"

FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_AMD64_DIGEST} AS sys-amd64
ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SECURITY_SNAPSHOT
RUN { \
      echo 'Types: deb'; \
      echo "URIs: http://snapshot.debian.org/archive/debian/$DEBIAN_SNAPSHOT"; \
      echo 'Suites: trixie trixie-updates'; \
      echo 'Components: main'; \
      echo 'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp'; \
      echo ''; \
      echo 'Types: deb'; \
      echo "URIs: http://snapshot.debian.org/archive/debian-security/$DEBIAN_SECURITY_SNAPSHOT"; \
      echo 'Suites: trixie-security'; \
      echo 'Components: main'; \
      echo 'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp'; \
    } > /etc/apt/sources.list.d/debian.sources && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'if ! apt-get update; then' \
      '  echo "APT snapshot unavailable; using live Debian repositories" >&2' \
      '  {' \
      '    echo "Types: deb";' \
      '    echo "URIs: http://deb.debian.org/debian";' \
      '    echo "Suites: trixie trixie-updates";' \
      '    echo "Components: main";' \
      '    echo "Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp";' \
      '    echo "";' \
      '    echo "Types: deb";' \
      '    echo "URIs: http://deb.debian.org/debian-security";' \
      '    echo "Suites: trixie-security";' \
      '    echo "Components: main";' \
      '    echo "Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp";' \
      '  } > /etc/apt/sources.list.d/debian.sources' \
      '  rm -f /etc/apt/apt.conf.d/99snapshot' \
      '  apt-get update' \
      'fi' > /usr/local/bin/apt-update && \
    chmod +x /usr/local/bin/apt-update && \
    /usr/local/bin/apt-update && apt-get install --no-install-recommends -y \
    build-essential curl gcc g++ libc6-dev libssl-dev pkg-config ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_ARM64_DIGEST} AS sys-arm64
ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SECURITY_SNAPSHOT
RUN { \
      echo 'Types: deb'; \
      echo "URIs: http://snapshot.debian.org/archive/debian/$DEBIAN_SNAPSHOT"; \
      echo 'Suites: trixie trixie-updates'; \
      echo 'Components: main'; \
      echo 'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp'; \
      echo ''; \
      echo 'Types: deb'; \
      echo "URIs: http://snapshot.debian.org/archive/debian-security/$DEBIAN_SECURITY_SNAPSHOT"; \
      echo 'Suites: trixie-security'; \
      echo 'Components: main'; \
      echo 'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp'; \
    } > /etc/apt/sources.list.d/debian.sources && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'if ! apt-get update; then' \
      '  echo "APT snapshot unavailable; using live Debian repositories" >&2' \
      '  {' \
      '    echo "Types: deb";' \
      '    echo "URIs: http://deb.debian.org/debian";' \
      '    echo "Suites: trixie trixie-updates";' \
      '    echo "Components: main";' \
      '    echo "Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp";' \
      '    echo "";' \
      '    echo "Types: deb";' \
      '    echo "URIs: http://deb.debian.org/debian-security";' \
      '    echo "Suites: trixie-security";' \
      '    echo "Components: main";' \
      '    echo "Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp";' \
      '  } > /etc/apt/sources.list.d/debian.sources' \
      '  rm -f /etc/apt/apt.conf.d/99snapshot' \
      '  apt-get update' \
      'fi' > /usr/local/bin/apt-update && \
    chmod +x /usr/local/bin/apt-update && \
    /usr/local/bin/apt-update && apt-get install --no-install-recommends -y \
    build-essential curl gcc g++ libc6-dev libssl-dev pkg-config ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

FROM --platform=$BUILDPLATFORM sys-${BUILDARCH} AS rust-base
ARG BUILDARCH
ARG RUSTUP_VERSION
ARG RUSTUP_AMD64_SHA256
ARG RUSTUP_ARM64_SHA256
ARG NODE_RUSTC_VERSION
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"
RUN case "$BUILDARCH" in \
      amd64) RUSTUP_ARCH=x86_64-unknown-linux-gnu; RUSTUP_SHA256="$RUSTUP_AMD64_SHA256" ;; \
      arm64) RUSTUP_ARCH=aarch64-unknown-linux-gnu; RUSTUP_SHA256="$RUSTUP_ARM64_SHA256" ;; \
      *) echo "unsupported BUILDARCH=$BUILDARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUSTUP_ARCH}/rustup-init" -o /tmp/rustup-init && \
    echo "$RUSTUP_SHA256  /tmp/rustup-init" | sha256sum -c - && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --default-toolchain none --profile minimal && \
    rm /tmp/rustup-init && \
    rustup toolchain install "$NODE_RUSTC_VERSION" --profile minimal --component rustc,rust-std,cargo && \
    rustup default "$NODE_RUSTC_VERSION" && \
    rm -rf /usr/local/rustup/downloads /usr/local/rustup/tmp \
      /usr/local/rustup/toolchains/*/share/doc /usr/local/rustup/toolchains/*/share/man

FROM scratch AS sources
COPY ./ave/http/Cargo.toml ./ave/http/Cargo.toml
COPY ./ave/identity/Cargo.toml ./ave/identity/Cargo.toml
COPY ./ave/core/Cargo.toml ./ave/core/Cargo.toml
COPY ./ave/bridge/Cargo.toml ./ave/bridge/Cargo.toml
COPY ./ave/network/Cargo.toml ./ave/network/Cargo.toml
COPY ./ave/common/Cargo.toml ./ave/common/Cargo.toml
COPY ./ave/build/Cargo.toml ./ave/build/Cargo.toml
COPY ./ave/Cargo.toml ./ave/Cargo.toml
COPY ./ave/Cargo.lock ./ave/Cargo.lock
COPY ./ave/README.md ./ave/README.md
COPY ./ave/common/pins ./ave/common/pins
COPY ./ave/common/build.rs ./ave/common/build.rs
COPY ./ave/common/proto ./ave/common/proto
COPY ./ave-actors/actor/Cargo.toml ./ave-actors/actor/Cargo.toml
COPY ./ave-actors/actor/README.md ./ave-actors/actor/README.md
COPY ./ave-actors/databases/rocksdb_db/Cargo.toml ./ave-actors/databases/rocksdb_db/Cargo.toml
COPY ./ave-actors/databases/rocksdb_db/README.md ./ave-actors/databases/rocksdb_db/README.md
COPY ./ave-actors/databases/sqlite_db/Cargo.toml ./ave-actors/databases/sqlite_db/Cargo.toml
COPY ./ave-actors/databases/sqlite_db/README.md ./ave-actors/databases/sqlite_db/README.md
COPY ./ave-actors/store/Cargo.toml ./ave-actors/store/Cargo.toml
COPY ./ave-actors/store/README.md ./ave-actors/store/README.md
COPY ./ave-actors/Cargo.toml ./ave-actors/Cargo.toml
COPY ./ave-actors/Cargo.lock ./ave-actors/Cargo.lock
COPY ./ave-actors/README.md ./ave-actors/README.md
COPY ./ave-contract-sdk/Cargo.toml ./ave-contract-sdk/Cargo.toml
COPY ./ave-contract-sdk/src ./ave-contract-sdk/src
COPY ./ave/http/src ./ave/http/src
COPY ./ave/http/migrations ./ave/http/migrations
COPY ./ave/src ./ave/src
COPY ./ave/identity/src ./ave/identity/src
COPY ./ave/core/src ./ave/core/src
COPY ./ave/core/migrations ./ave/core/migrations
COPY ./ave/bridge/src ./ave/bridge/src
COPY ./ave/network/src ./ave/network/src
COPY ./ave/common/src ./ave/common/src
COPY ./ave/build/src ./ave/build/src
COPY ./ave-actors/actor/src ./ave-actors/actor/src
COPY ./ave-actors/databases/rocksdb_db/src ./ave-actors/databases/rocksdb_db/src
COPY ./ave-actors/databases/sqlite_db/src ./ave-actors/databases/sqlite_db/src
COPY ./ave-actors/store/src ./ave-actors/store/src
COPY ./ave-actors/src ./ave-actors/src

FROM --platform=$BUILDPLATFORM rust-base AS builder
ARG BUILDARCH
ARG TARGETARCH
ARG NODE_RUSTC_VERSION
ARG CARGO_PROFILE
ARG FEATURES
RUN case "$TARGETARCH" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-gnu; RUST_TARGET_VAR=x86_64_unknown_linux_gnu; TARGET_KEY=X86_64_UNKNOWN_LINUX_GNU; GNU_TRIPLE=x86_64-linux-gnu; CROSS_GCC=gcc-x86-64-linux-gnu; CROSS_GXX=g++-x86-64-linux-gnu ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-gnu; RUST_TARGET_VAR=aarch64_unknown_linux_gnu; TARGET_KEY=AARCH64_UNKNOWN_LINUX_GNU; GNU_TRIPLE=aarch64-linux-gnu; CROSS_GCC=gcc-aarch64-linux-gnu; CROSS_GXX=g++-aarch64-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
      dpkg --add-architecture "$TARGETARCH" && /usr/local/bin/apt-update && \
      apt-get install --no-install-recommends -y \
        "$CROSS_GCC" "$CROSS_GXX" "libc6-dev-$TARGETARCH-cross" \
        "libssl-dev:$TARGETARCH" "zlib1g:$TARGETARCH" && \
      apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi && \
    rustup target add "$RUST_TARGET" --toolchain "$NODE_RUSTC_VERSION" && \
    { \
      echo "export RUST_TARGET=$RUST_TARGET"; \
      echo "export CC=$GNU_TRIPLE-gcc"; \
      echo "export CXX=$GNU_TRIPLE-g++"; \
      echo "export CC_$RUST_TARGET_VAR=$GNU_TRIPLE-gcc"; \
      echo "export CXX_$RUST_TARGET_VAR=$GNU_TRIPLE-g++"; \
      echo "export AR_$RUST_TARGET_VAR=$GNU_TRIPLE-ar"; \
      echo "export CARGO_TARGET_${TARGET_KEY}_LINKER=$GNU_TRIPLE-gcc"; \
      echo "export PKG_CONFIG_ALLOW_CROSS=1"; \
      echo "export PKG_CONFIG_LIBDIR=/usr/lib/$GNU_TRIPLE/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"; \
      echo "export OPENSSL_DIR=/usr"; \
      echo "export OPENSSL_LIB_DIR=/usr/lib/$GNU_TRIPLE"; \
      echo "export OPENSSL_INCLUDE_DIR=/usr/include"; \
    } > /etc/ave-target.env && \
    if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
      echo "export BINDGEN_EXTRA_CLANG_ARGS='--sysroot=/usr/$GNU_TRIPLE -I/usr/$GNU_TRIPLE/include'" >> /etc/ave-target.env; \
    fi

COPY --from=sources / /
WORKDIR /ave/http
RUN --mount=type=cache,id=ave-node-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ave-node-sqlite-${BUILDARCH}-${TARGETARCH},target=/ave/target \
    . /etc/ave-target.env && \
    cargo build --locked --target "$RUST_TARGET" --profile "$CARGO_PROFILE" --no-default-features --features "$FEATURES" && \
    mkdir -p /out && cp "/ave/target/$RUST_TARGET/$CARGO_PROFILE/ave-http" /out/ave-http && \
    mkdir -p /contracts/contracts /contracts/target /volumes/db /volumes/keys /volumes/logs && \
    chown -R 65532:65532 /contracts /volumes

FROM --platform=$BUILDPLATFORM sys-${BUILDARCH} AS libs
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) ARCH_LIB=x86_64-linux-gnu ;; \
      arm64) ARCH_LIB=aarch64-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    dpkg --add-architecture "$TARGETARCH" && /usr/local/bin/apt-update && \
    mkdir -p /debs /out && cd /debs && \
    apt-get download "libssl3t64:$TARGETARCH" "zlib1g:$TARGETARCH" && \
    for deb in *.deb; do dpkg-deb -x "$deb" /out; done && \
    cd / && rm -rf /debs && \
    apt-get install --no-install-recommends -y ca-certificates && \
    update-ca-certificates --fresh && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    test -f "/out/usr/lib/$ARCH_LIB/libssl.so.3"

FROM gcr.io/distroless/cc-debian13@${DISTROLESS_AMD64_DIGEST} AS amd64
COPY --from=libs /out/usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/
COPY --from=libs /out/usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/
COPY --from=libs /out/usr/lib/x86_64-linux-gnu/libz.so.1 /usr/lib/x86_64-linux-gnu/
COPY --from=libs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /out/ave-http /usr/local/bin/ave-http
COPY --from=builder --chown=65532:65532 /contracts /contracts
COPY --from=builder --chown=65532:65532 /volumes/ /
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ave-http"]

FROM gcr.io/distroless/cc-debian13@${DISTROLESS_ARM64_DIGEST} AS arm64
COPY --from=libs /out/usr/lib/aarch64-linux-gnu/libssl.so.3 /usr/lib/aarch64-linux-gnu/
COPY --from=libs /out/usr/lib/aarch64-linux-gnu/libcrypto.so.3 /usr/lib/aarch64-linux-gnu/
COPY --from=libs /out/usr/lib/aarch64-linux-gnu/libz.so.1 /usr/lib/aarch64-linux-gnu/
COPY --from=libs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /out/ave-http /usr/local/bin/ave-http
COPY --from=builder --chown=65532:65532 /contracts /contracts
COPY --from=builder --chown=65532:65532 /volumes/ /
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ave-http"]

# Shared native target configuration. No target binary is executed here.
FROM --platform=$BUILDPLATFORM rust-base AS target-config
ARG BUILDARCH
ARG TARGETARCH
ARG NODE_RUSTC_VERSION
RUN case "$TARGETARCH" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-gnu; RUST_TARGET_VAR=x86_64_unknown_linux_gnu; TARGET_KEY=X86_64_UNKNOWN_LINUX_GNU; GNU_TRIPLE=x86_64-linux-gnu; CROSS_GCC=gcc-x86-64-linux-gnu; CROSS_GXX=g++-x86-64-linux-gnu ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-gnu; RUST_TARGET_VAR=aarch64_unknown_linux_gnu; TARGET_KEY=AARCH64_UNKNOWN_LINUX_GNU; GNU_TRIPLE=aarch64-linux-gnu; CROSS_GCC=gcc-aarch64-linux-gnu; CROSS_GXX=g++-aarch64-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
      dpkg --add-architecture "$TARGETARCH" && /usr/local/bin/apt-update && \
      apt-get install --no-install-recommends -y \
        "$CROSS_GCC" "$CROSS_GXX" "libc6-dev-$TARGETARCH-cross" \
        "libssl-dev:$TARGETARCH" "zlib1g:$TARGETARCH" "libcurl4:$TARGETARCH" && \
      apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi && \
    rustup target add "$RUST_TARGET" --toolchain "$NODE_RUSTC_VERSION" && \
    { \
      echo "export RUST_TARGET=$RUST_TARGET"; \
      echo "export GNU_TRIPLE=$GNU_TRIPLE"; \
      echo "export ARCH_LIB=$GNU_TRIPLE"; \
      echo "export CC=$GNU_TRIPLE-gcc"; \
      echo "export CXX=$GNU_TRIPLE-g++"; \
      echo "export CC_$RUST_TARGET_VAR=$GNU_TRIPLE-gcc"; \
      echo "export CXX_$RUST_TARGET_VAR=$GNU_TRIPLE-g++"; \
      echo "export AR_$RUST_TARGET_VAR=$GNU_TRIPLE-ar"; \
      echo "export CARGO_TARGET_${TARGET_KEY}_LINKER=$GNU_TRIPLE-gcc"; \
      echo "export PKG_CONFIG_ALLOW_CROSS=1"; \
      echo "export PKG_CONFIG_LIBDIR=/usr/lib/$GNU_TRIPLE/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"; \
      echo "export OPENSSL_DIR=/usr"; \
      echo "export OPENSSL_LIB_DIR=/usr/lib/$GNU_TRIPLE"; \
      echo "export OPENSSL_INCLUDE_DIR=/usr/include"; \
    } > /etc/ave-target.env && \
    if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
      echo "export BINDGEN_EXTRA_CLANG_ARGS='--sysroot=/usr/$GNU_TRIPLE -I/usr/$GNU_TRIPLE/include'" >> /etc/ave-target.env; \
    fi

# The node binary has no dependency on contract toolchain packaging.
FROM --platform=$BUILDPLATFORM target-config AS node-builder
ARG BUILDARCH
ARG TARGETARCH
ARG CARGO_PROFILE
ARG FEATURES
COPY --from=sources /ave /ave
COPY --from=sources /ave-actors /ave-actors
COPY --from=sources /ave-contract-sdk /ave-contract-sdk
WORKDIR /ave/http
RUN --mount=type=cache,id=ave-node-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ave-node-compiler-${BUILDARCH}-${TARGETARCH},target=/ave/target \
    . /etc/ave-target.env && \
    cargo build --locked --target "$RUST_TARGET" --profile "$CARGO_PROFILE" --no-default-features --features "$FEATURES" && \
    mkdir -p /out && cp "/ave/target/$RUST_TARGET/$CARGO_PROFILE/ave-http" /out/ave-http && \
    mkdir -p /volumes/db /volumes/keys /volumes/logs && chown -R 65532:65532 /volumes

# Final contract sources are packaged independently of dependency resolution.
FROM scratch AS contract-sources
COPY --from=sources /ave-contract-sdk /runtime-sources/home/ale/dev/ave-contract-sdk
COPY --from=sources /ave/Cargo.toml /runtime-sources/home/ale/dev/ave/Cargo.toml
COPY --from=sources /ave/README.md /runtime-sources/home/ale/dev/ave/README.md
COPY --from=sources /ave/src /runtime-sources/home/ale/dev/ave/src
COPY --from=sources /ave/common/Cargo.toml /runtime-sources/home/ale/dev/ave/common/Cargo.toml
COPY --from=sources /ave/common/build.rs /runtime-sources/home/ale/dev/ave/common/build.rs
COPY --from=sources /ave/common/src/lib.rs /runtime-sources/home/ale/dev/ave/common/src/lib.rs
COPY --from=sources /ave/common/src/wrapper.rs /runtime-sources/home/ale/dev/ave/common/src/wrapper.rs

# Contract dependency resolution is independent of the toolchain and node.
FROM --platform=$BUILDPLATFORM target-config AS contract-vendor
ARG TARGETARCH
ARG PIN_LOCKFILE
COPY --from=sources /ave/Cargo.toml /ave/Cargo.toml
COPY --from=sources /ave/README.md /ave/README.md
COPY --from=sources /ave/http/Cargo.toml /ave/http/Cargo.toml
COPY --from=sources /ave/identity/Cargo.toml /ave/identity/Cargo.toml
COPY --from=sources /ave/core/Cargo.toml /ave/core/Cargo.toml
COPY --from=sources /ave/bridge/Cargo.toml /ave/bridge/Cargo.toml
COPY --from=sources /ave/network/Cargo.toml /ave/network/Cargo.toml
COPY --from=sources /ave/build/Cargo.toml /ave/build/Cargo.toml
COPY --from=sources /ave/common/Cargo.toml /ave/common/Cargo.toml
COPY --from=sources /ave/common/build.rs /ave/common/build.rs
COPY --from=sources /ave/common/src/lib.rs /ave/common/src/lib.rs
COPY --from=sources /ave/common/src/wrapper.rs /ave/common/src/wrapper.rs
COPY --from=sources /ave/common/pins /ave/common/pins
COPY --from=sources /ave-contract-sdk /ave-contract-sdk
COPY --from=sources /ave-reproducible-wasm/config/toolchain.env /tmp/toolchain.env
COPY --from=sources /ave-reproducible-wasm/dist/cargo-ave-${TARGETARCH} /usr/local/bin/cargo-ave-pinned
RUN --mount=type=cache,id=ave-node-registry,target=/usr/local/cargo/registry \
    case "$TARGETARCH" in \
      amd64) HASH_KEY=CARGO_BINARY_SHA256_AMD64 ;; \
      arm64) HASH_KEY=CARGO_BINARY_SHA256_ARM64 ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    test "$(sha256sum /usr/local/bin/cargo-ave-pinned | cut -d' ' -f1)" = "$(grep "^${HASH_KEY}=" /tmp/toolchain.env | cut -d= -f2)" && \
    mkdir -p /contracts/contracts /contracts/vendor /contracts/target /tmp/contract-template/src && \
    printf '// Empty crate used to resolve and validate the pinned dependencies.\n' > /tmp/contract-template/src/lib.rs && \
    mkdir -p /tmp/contract-template/.cargo && \
    sed 's#path = "/home/ale/dev/ave-contract-sdk"#path = "/ave-contract-sdk"#' /ave-contract-sdk/src/runtime/contract_Cargo.toml > /tmp/contract-template/Cargo.toml && \
    cp "/ave/common/pins/${PIN_LOCKFILE}" /tmp/contract-template/Cargo.lock && \
    cargo fetch --locked --manifest-path /tmp/contract-template/Cargo.toml && \
    cargo vendor --locked --offline --manifest-path /tmp/contract-template/Cargo.toml /contracts/vendor && \
    printf '[build]\ntarget-dir = "/contracts/target"\n\n[net]\noffline = true\n\n[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "/contracts/vendor"\n' > /contracts/vendor-config.toml && \
    cp /contracts/vendor-config.toml /tmp/contract-template/.cargo/config.toml

# The contract toolchain only changes with its pin or host/target selection.
FROM --platform=$BUILDPLATFORM target-config AS contract-toolchain
ARG BUILDARCH
ARG TARGETARCH
ARG RUSTC_VERSION
ARG NODE_RUSTC_VERSION
RUN . /etc/ave-target.env && \
    if [ "$BUILDARCH" = "$TARGETARCH" ]; then \
      rustup toolchain install "$RUSTC_VERSION" --profile minimal --component rustc,rust-std,cargo,rust-src && \
      rustup target add wasm32-unknown-unknown --toolchain "$RUSTC_VERSION"; \
    else \
      rustup toolchain install "$RUSTC_VERSION-$RUST_TARGET" --force-non-host --profile minimal --component rustc,rust-std,cargo,rust-src && \
      rustup target add wasm32-unknown-unknown --toolchain "$RUSTC_VERSION-$RUST_TARGET"; \
    fi && \
    if [ "$BUILDARCH" = "$TARGETARCH" ]; then \
      if [ "$NODE_RUSTC_VERSION" != "$RUSTC_VERSION" ]; then rustup toolchain uninstall "$NODE_RUSTC_VERSION" && rustup default "$RUSTC_VERSION"; fi; \
    else \
      rustup toolchain uninstall "$NODE_RUSTC_VERSION" && rustup default --force-non-host "$RUSTC_VERSION-$RUST_TARGET"; \
    fi && \
    rm -rf /usr/local/rustup/downloads /usr/local/rustup/tmp /usr/local/cargo/git \
      /usr/local/rustup/toolchains/*/share/doc /usr/local/rustup/toolchains/*/share/man && \
    rm -f /usr/local/rustup/toolchains/*/bin/rustdoc /usr/local/rustup/toolchains/*/bin/rust-gdb* && \
    rm -f /usr/local/rustup/toolchains/*/lib/rustlib/*/lib/librustc-stable_rt.*san.a \
      /usr/local/rustup/toolchains/*/lib/rustlib/*/lib/libtest-* \
      /usr/local/rustup/toolchains/*/lib/rustlib/*/lib/libbench-* && \
    chmod -R a+rX /usr/local/rustup /usr/local/cargo

# Assemble the independent artifacts and warm up only a native toolchain.
FROM --platform=$BUILDPLATFORM contract-toolchain AS contract-builder
ARG BUILDARCH
ARG TARGETARCH
ARG RUSTC_VERSION
COPY --from=contract-vendor /contracts /contracts
COPY --from=contract-vendor /tmp/contract-template /tmp/contract-template
COPY --from=contract-sources /runtime-sources /runtime-sources
COPY --from=contract-vendor /usr/local/bin/cargo-ave-pinned /usr/local/bin/cargo-ave-pinned
COPY --from=contract-vendor /ave /ave
COPY --from=contract-vendor /ave-contract-sdk /ave-contract-sdk
RUN . /etc/ave-target.env && \
    if [ "$BUILDARCH" = "$TARGETARCH" ]; then \
      rustup run "$RUSTC_VERSION" cargo --config /tmp/contract-template/.cargo/config.toml build --locked --manifest-path /tmp/contract-template/Cargo.toml --target wasm32-unknown-unknown --release --offline; \
    fi && \
    rm -rf /contracts/target /tmp/contract-template && \
    mkdir -p /contracts/target && chown -R 65532:65532 /contracts /home/ave && \
    chmod -R a+rX /usr/local/rustup /usr/local/cargo && \
    mkdir -p /toolchain-root/usr/local/bin && \
    cp -a /usr/local/rustup /toolchain-root/usr/local/rustup && \
    if [ "$BUILDARCH" = "$TARGETARCH" ]; then \
      cp -L /usr/local/cargo/bin/rustup /toolchain-root/usr/local/bin/rustup; \
    fi && \
    ln -s "/usr/local/rustup/toolchains/$RUSTC_VERSION-$RUST_TARGET/bin/cargo" /toolchain-root/usr/local/bin/cargo && \
    ln -s "/usr/local/rustup/toolchains/$RUSTC_VERSION-$RUST_TARGET/bin/rustc" /toolchain-root/usr/local/bin/rustc

# Native GCC for the target image and its exact shared-library closure.
FROM --platform=$BUILDPLATFORM target-config AS runtime-gcc
ARG BUILDARCH
ARG TARGETARCH
COPY --from=sources /ave-reproducible-wasm/dist/cargo-ave-${TARGETARCH} /usr/local/bin/cargo-ave-pinned
RUN . /etc/ave-target.env && \
    if [ "$BUILDARCH" != "$TARGETARCH" ]; then \
      mkdir -p /debs-target && \
      /usr/local/bin/apt-update && \
      apt-get -o Dir::Cache::Archives=/debs-target install --download-only -y --no-install-recommends \
        "gcc:$TARGETARCH" "binutils:$TARGETARCH" "libc6-dev:$TARGETARCH" "libstdc++6:$TARGETARCH" && \
      mkdir -p /cross-cc && \
      for deb in /debs-target/*.deb; do dpkg-deb -x "$deb" /cross-cc; done && \
      rm -rf /debs-target; \
    fi
RUN . /etc/ave-target.env && \
    mkdir -p /runtime-libs/lib /runtime-libs/lib64 /runtime-libs/usr && \
    if [ "$BUILDARCH" = "$TARGETARCH" ]; then \
      GCC_PROGS="/usr/bin/cc /usr/bin/gcc /usr/bin/$GNU_TRIPLE-gcc /usr/bin/as /usr/bin/ld /usr/bin/ar /usr/bin/$GNU_TRIPLE-as /usr/bin/$GNU_TRIPLE-ld /usr/bin/$GNU_TRIPLE-ar" && \
      for prog in cc1 collect2 lto-wrapper lto1; do \
        for driver in /usr/bin/gcc /usr/bin/$GNU_TRIPLE-gcc /usr/bin/cc; do \
          p=$($driver -print-prog-name=$prog 2>/dev/null | grep '^/' || true); \
          [ -n "$p" ] && GCC_PROGS="$GCC_PROGS $p"; \
        done; \
      done && \
      for bin in /usr/local/bin/cargo-ave-pinned $GCC_PROGS; do \
        [ -f "$bin" ] || continue; \
        for lib in $(ldd "$bin" 2>/dev/null | grep -o '/[^ ]*' || true); do \
          dest="/runtime-libs${lib}"; \
          if [ ! -e "$dest" ]; then mkdir -p "$(dirname "$dest")"; cp -L "$lib" "$dest"; fi; \
        done; \
        case "$bin" in /usr/bin/*|/bin/*|/usr/local/bin/cargo-ave-*) ;; *) \
          dest="/runtime-libs$bin"; \

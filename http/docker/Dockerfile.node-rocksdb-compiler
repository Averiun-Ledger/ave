FROM --platform=$BUILDPLATFORM sys-${BUILDARCH} AS libs
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) ARCH_LIB=x86_64-linux-gnu ;; \
      arm64) ARCH_LIB=aarch64-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    dpkg --add-architecture "$TARGETARCH" && /usr/local/bin/apt-update && \
    mkdir -p /debs /out && cd /debs && \
    apt-get download "libssl3t64:$TARGETARCH" "zlib1g:$TARGETARCH" && \
    for deb in *.deb; do dpkg-deb -x "$deb" /out; done && \
    cd / && rm -rf /debs && \
    apt-get install --no-install-recommends -y ca-certificates && \
    update-ca-certificates --fresh && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    test -f "/out/usr/lib/$ARCH_LIB/libssl.so.3"

FROM gcr.io/distroless/cc-debian13@${DISTROLESS_AMD64_DIGEST} AS amd64
ARG RUSTC_VERSION
COPY --from=libs /out/usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/

# Ave node, RocksDB + compiler role (in-process toolchain).
# One file builds both architectures WITHOUT emulation: every builder
# stage runs natively on the host arch and cross-compiles the other
# arch with the matching cross toolchain.
# Usage (from the workspace root /home/ale/dev):
#   docker build --target amd64 -f ave/http/docker/Dockerfile.node-rocksdb-compiler .
#   docker build --target arm64 -f ave/http/docker/Dockerfile.node-rocksdb-compiler .

ARG DEBIAN_AMD64_DIGEST=sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2
ARG DEBIAN_ARM64_DIGEST=sha256:a66b19aa552f595b4ab276c6b4f9b24fa4546632c5ecd88cccdced4a6866323a
ARG DISTROLESS_AMD64_DIGEST=sha256:a0426fc2d66bbaa64fa3577e6d654411a671752b8eba243882cc3cc533a00613
ARG DISTROLESS_ARM64_DIGEST=sha256:76fe70b16ed7943288c1aacecbdb73edfdb5f5e75577ad6ae4de069b966862c9
ARG RUSTUP_VERSION=1.28.2
# Active pin: keep in sync with ave-common governance DEFAULT_PIN.
# Changing the pin means a new image (never redefine).
ARG PIN=rust-1.95.0_sdk-0.8.0_wasm32
ARG PIN_LOCKFILE=contract-v1.Cargo.lock
ARG RUSTC_VERSION=1.95.0
ARG NODE_RUSTC_VERSION=1.98.1
ARG CARGO_PROFILE=release
ARG FEATURES="ext-sqlite rocksdb prometheus toolchain"

# ============================================================================
# System layers (native build tools; cross toolchains per builder below)
# ============================================================================
FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_AMD64_DIGEST} AS sys-amd64
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential clang cmake curl gcc g++ libclang-dev libc6-dev \
    libssl-dev pkg-config llvm-dev ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_ARM64_DIGEST} AS sys-arm64
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential clang cmake curl gcc g++ libclang-dev libc6-dev \
    libssl-dev pkg-config llvm-dev ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Rust toolchain layer (pinned rustup + pinned toolchain + wasm target)
# ============================================================================
FROM --platform=$BUILDPLATFORM sys-${BUILDARCH} AS rust-base
ARG RUSTUP_VERSION
ARG RUSTC_VERSION
ARG NODE_RUSTC_VERSION
ARG TARGETARCH
# Fixed homes so every absolute path below is identical on all
# hosts and in all images. Toolchains must stay readable for the
# non-root runtime user; the sandbox remounts them read-only anyway.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo HOME=/home/ave
ENV PATH="/usr/local/cargo/bin:/usr/local/bin:${PATH}"
RUN case "$TARGETARCH" in \
      amd64) RUSTUP_ARCH=x86_64-unknown-linux-gnu ;; \
      arm64) RUSTUP_ARCH=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUSTUP_ARCH}/rustup-init" -o /tmp/rustup-init && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --default-toolchain none --profile minimal && \
    rm /tmp/rustup-init && \
    mkdir -p /home/ave && chown 65532:65532 /home/ave
# Node toolchain (builds ave-http itself; must satisfy all deps' MSRV)
# plus the pinned contract toolchain (compiles contracts on-chain).
# The node binary is built with the default toolchain below.
# Minimal profile + explicit components: no clippy, rustfmt, docs.
RUN rustup toolchain install "$NODE_RUSTC_VERSION" --profile minimal --component rustc,rust-std,cargo && \
    rustup toolchain install "$RUSTC_VERSION" --profile minimal --component rustc,rust-std,cargo,rust-src && \
    rustup target add wasm32-unknown-unknown --toolchain "$RUSTC_VERSION" && \
    rustup default "$NODE_RUSTC_VERSION" && \
    rm -rf /usr/local/rustup/downloads /usr/local/rustup/tmp && \
    rm -rf /usr/local/rustup/toolchains/*/share/doc /usr/local/rustup/toolchains/*/share/man && \
    rm -rf /usr/local/cargo/registry /usr/local/cargo/git && \
    chmod -R a+rX /usr/local/rustup /usr/local/cargo


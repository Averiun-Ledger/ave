ENV RUSTUP_HOME=/usr/local/rustup HOME=/home/ave
ENV PATH="/usr/local/rustup/toolchains/${RUSTC_VERSION}-x86_64-unknown-linux-gnu/bin:/usr/local/bin:${PATH}"
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ave-http"]


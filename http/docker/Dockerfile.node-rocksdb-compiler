FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_AMD64_DIGEST} AS libs-amd64
# Native: install straight. Crossing: download the TARGET-arch debs
# and unpack without maintainer scripts — never executes foreign
# binaries (no QEMU anywhere). Same on-disk layout either way.
RUN if [ "$(uname -m)" = "x86_64" ]; then \
      apt-get update && apt-get install --no-install-recommends -y \
        libssl3t64 zlib1g ca-certificates \
        && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    else \
      dpkg --add-architecture amd64 && apt-get update && \
      mkdir -p /debs-amd64 && cd /debs-amd64 && \
      apt-get download libssl3t64:amd64 zlib1g:amd64 ca-certificates:amd64 && \
      for deb in *.deb; do dpkg-deb -x "$deb" /; done && \
      cd / && rm -rf /debs-amd64 /var/lib/apt/lists/* && \
      test -f /etc/ssl/certs/ca-certificates.crt || \
        (apt-get update && apt-get install -y ca-certificates && update-ca-certificates --fresh); \
    fi

FROM --platform=$BUILDPLATFORM debian:trixie-slim@${DEBIAN_ARM64_DIGEST} AS libs-arm64
# Native: install straight. Crossing: download the TARGET-arch debs
